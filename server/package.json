{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:stock": "node --test tests/stock.test.cjs",
    "test:recipes": "node --test tests/recipes.test.cjs",
    "test:suggestions": "node --test tests/suggestions.test.cjs",
    "test:dossier": "node --test tests/dossier.test.cjs",
    "test:units": "node --test tests/units.test.cjs",
    "seed:ingredients": "node prisma/seed-ingredients.cjs --apply",
    "test:catalogue": "node --test tests/catalogue.test.cjs",
    "seed:ingredients:check": "node prisma/seed-ingredients.cjs --dry-run",
    "seed:recipes": "node prisma/seed-recipes.cjs --apply",
    "seed:recipes:check": "node prisma/seed-recipes.cjs --dry-run",
    "test:recipe-catalogue": "node --test tests/recipe-catalogue.test.cjs",
    "seed:recipe-images": "node prisma/seed-recipe-images.cjs --apply",
    "seed:recipe-images:check": "node prisma/seed-recipe-images.cjs --dry-run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "prisma": "^6.19.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
