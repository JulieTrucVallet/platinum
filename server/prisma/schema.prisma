generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int              @id @default(autoincrement())
  username    String           @unique
  email       String           @unique
  password    String
  role        Role             @default(USER)
  createdAt   DateTime         @default(now())
  stockItems  StockItem[]
  recipes     Recipe[]
  preferences UserPreference[]
}

model Ingredient {
  id          Int                @id @default(autoincrement())
  name        String
  slug        String             @unique
  // All quantities for an ingredient use this reference unit.
  unit        IngredientUnit
  stockItems  StockItem[]
  recipeItems RecipeIngredient[]
}

model StockItem {
  id           Int             @id @default(autoincrement())
  userId       Int
  ingredientId Int
  // Positive quantity in Ingredient.unit; enforced by a SQL CHECK.
  quantity     Decimal         @db.Decimal(12, 3)
  location     StorageLocation @default(PANTRY)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([userId, ingredientId, location])
  @@index([ingredientId])
}

model Category {
  id      Int      @id @default(autoincrement())
  name    String
  slug    String   @unique
  recipes Recipe[]
}

model Recipe {
  id                 Int                @id @default(autoincrement())
  title              String
  instructions       String             @db.Text
  imageUrl           String?
  // Quantities describe this number of servings, not one serving.
  servings           Int                @default(2)
  preparationMinutes Int                @default(0)
  cookingMinutes     Int                @default(0)
  difficulty         Difficulty?
  // Optional reference for externally sourced recipes.
  source             String?
  authorId           Int?
  categoryId         Int
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  author             User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ingredients        RecipeIngredient[]
  preferences        RecipePreference[]

  @@index([authorId])
  @@index([categoryId])
}

model RecipeIngredient {
  recipeId     Int
  ingredientId Int
  // Positive quantity in Ingredient.unit, for Recipe.servings servings.
  quantity     Decimal    @db.Decimal(12, 3)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([recipeId, ingredientId])
  @@index([ingredientId])
}

model FoodPreference {
  id      Int                @id @default(autoincrement())
  name    String
  slug    String             @unique
  users   UserPreference[]
  recipes RecipePreference[]
}

model UserPreference {
  userId       Int
  preferenceId Int
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  preference   FoodPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@id([userId, preferenceId])
  @@index([preferenceId])
}

model RecipePreference {
  recipeId     Int
  preferenceId Int
  recipe       Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  preference   FoodPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@id([recipeId, preferenceId])
  @@index([preferenceId])
}

enum Role {
  USER
  ADMIN
}

enum IngredientUnit {
  GRAM
  MILLILITER
  PIECE
}

enum StorageLocation {
  FRIDGE
  FREEZER
  PANTRY
  CONDIMENTS
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
